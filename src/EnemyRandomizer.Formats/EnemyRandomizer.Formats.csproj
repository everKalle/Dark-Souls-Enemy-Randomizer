<Project Sdk="Microsoft.NET.Sdk">

  <!-- Game file formats: pure byte[] <-> model, no file system access (migration step 4). -->
  <PropertyGroup>
    <RootNamespace>EnemyRandomizer.Formats</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.json" LogicalName="EnemyRandomizer.Formats.Resources.%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="EnemyRandomizer.Formats.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnemyRandomizer.Core\EnemyRandomizer.Core.csproj" />
  </ItemGroup>

</Project>
