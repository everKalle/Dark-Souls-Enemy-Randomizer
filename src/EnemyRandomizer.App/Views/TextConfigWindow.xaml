<Window x:Class="EnemyRandomizer.App.Views.TextConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EnemyRandomizer.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:TextConfigViewModel}"
        Style="{StaticResource AppWindow}"
        Title="Text config" Width="820" SizeToContent="Height" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="16">
    <TextBlock Text="{Binding HelpText}" TextWrapping="Wrap" Margin="0,0,0,12" />
    <TextBox Text="{Binding ConfigText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"
             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="110" MaxHeight="220"
             AutomationProperties.Name="Settings text" Margin="0,0,0,4" />
    <TextBlock Text="This field does not update by itself. Select Generate to fill it with your current settings."
               Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
    <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,6">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
          <Style.Triggers>
            <Trigger Property="Text" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}"
               AutomationProperties.LiveSetting="Polite" Margin="0,0,0,6" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Content="_Generate from current settings" Command="{Binding GenerateCommand}" Margin="0,0,8,0" />
      <Button Content="_Copy" Command="{Binding CopyCommand}" Margin="0,0,8,0" />
      <Button Content="_Apply to settings" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Margin="0" />
    </StackPanel>
  </StackPanel>
</Window>
