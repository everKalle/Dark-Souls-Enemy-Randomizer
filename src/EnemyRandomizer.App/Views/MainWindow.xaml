<Window x:Class="EnemyRandomizer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EnemyRandomizer.App.ViewModels"
        xmlns:opt="clr-namespace:EnemyRandomizer.App.ViewModels.Options"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Style="{StaticResource AppWindow}"
        Title="{Binding Title}"
        Icon="/Assets/app.ico"
        Width="1280" Height="760" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- Radio button group option -->
    <DataTemplate DataType="{x:Type opt:ChoiceOptionViewModel}">
      <GroupBox Header="{Binding DisplayTitle}" IsEnabled="{Binding IsEnabled}"
                MouseEnter="Option_MouseEnter" MouseLeave="Option_MouseLeave">
        <ItemsControl ItemsSource="{Binding Choices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type opt:ChoiceViewModel}">
              <RadioButton Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                           MouseEnter="Choice_MouseEnter" MouseLeave="Choice_MouseLeave" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </GroupBox>
    </DataTemplate>

    <!-- Percentage slider option -->
    <DataTemplate DataType="{x:Type opt:SliderOptionViewModel}">
      <GroupBox Header="{Binding DisplayTitle}" IsEnabled="{Binding IsEnabled}"
                MouseEnter="Option_MouseEnter" MouseLeave="Option_MouseLeave">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="40" />
          </Grid.ColumnDefinitions>
          <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value, Mode=TwoWay}"
                  IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10"
                  VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat={}{0}%}" TextAlignment="Right"
                     VerticalAlignment="Center" FontWeight="SemiBold" />
        </Grid>
      </GroupBox>
    </DataTemplate>

    <!-- One entry of the description panel -->
    <DataTemplate x:Key="DescriptionTemplate" DataType="{x:Type opt:OptionViewModel}">
      <Border x:Name="Card" Padding="10,8" Margin="0,0,0,6" CornerRadius="4" Background="Transparent">
        <StackPanel>
          <TextBlock x:Name="Heading" Text="{Binding Definition.Title}" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,2" />
          <TextBlock x:Name="Body" Text="{Binding DisplayedDescription}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Faded">
          <Setter TargetName="Body" Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Hovered">
          <Setter TargetName="Card" Property="Background" Value="{StaticResource HighlightBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Preview">
          <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSoftBrush}" />
          <Setter TargetName="Body" Property="Foreground" Value="{StaticResource AccentBrush}" />
          <Setter TargetName="Heading" Property="Foreground" Value="{StaticResource AccentBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
          <Setter TargetName="Card" Property="Opacity" Value="0.55" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="300" />
      <ColumnDefinition Width="2*" MinWidth="440" />
      <ColumnDefinition Width="230" />
    </Grid.ColumnDefinitions>

    <!-- Top bar -->
    <Button Grid.Row="0" Grid.Column="0" Content="About" Command="{Binding ShowAboutCommand}"
            HorizontalAlignment="Left" Margin="0,0,0,10" />

    <DockPanel Grid.Row="0" Grid.Column="1" Margin="12,0,8,10">
      <TextBlock DockPanel.Dock="Left" Text="Seed (leave blank for random):" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
    </DockPanel>

    <Button Grid.Row="0" Grid.Column="2" Content="Open config input" Command="{Binding OpenTextConfigCommand}"
            Margin="0,0,0,10" />

    <!-- Description panel -->
    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
        <ItemsControl ItemsSource="{Binding SelectedTab.Options}" ItemTemplate="{StaticResource DescriptionTemplate}" />
      </ScrollViewer>
    </Border>

    <!-- Option tabs -->
    <TabControl Grid.Row="1" Grid.Column="1" Margin="12,0,12,0"
                ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
      <TabControl.ItemTemplate>
        <DataTemplate DataType="{x:Type opt:OptionTabViewModel}">
          <TextBlock Text="{Binding Title}" Padding="6,2" />
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate DataType="{x:Type opt:OptionTabViewModel}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
            <ItemsControl ItemsSource="{Binding Options}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemWidth="290" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>

    <!-- Actions -->
    <StackPanel Grid.Row="1" Grid.Column="2">
      <Button Content="Restore default settings" Command="{Binding RestoreDefaultsCommand}" Margin="0,0,0,12" />

      <GroupBox Header="Enemy placement copy" Margin="0,0,0,12">
        <StackPanel>
          <Button Content="Copy enemy placement" Command="{Binding CopyPlacementCommand}" />
          <Button Content="Info" Command="{Binding ShowCopyInfoCommand}" Margin="0" />
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Enemy Config" Margin="0,0,0,12">
        <StackPanel>
          <ComboBox ItemsSource="{Binding EnemyConfigNames}" SelectedItem="{Binding SelectedEnemyConfig}" Margin="0,0,0,6" />
          <Button Content="Open Enemy Config Editor" Command="{Binding OpenEnemyConfigEditorCommand}" Margin="0" />
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Randomization" Margin="0">
        <StackPanel>
          <Button Content="Randomize" Command="{Binding RandomizeCommand}" Style="{StaticResource PrimaryButton}" />
          <Button Content="Revert to normal" Command="{Binding RevertCommand}" Margin="0" />
        </StackPanel>
      </GroupBox>
    </StackPanel>

    <!-- Status -->
    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding EditionText}" Margin="0,10,0,0"
               Foreground="{StaticResource MutedTextBrush}" />
  </Grid>
</Window>
