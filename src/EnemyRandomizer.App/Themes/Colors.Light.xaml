<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Light palette: parchment surface, soot text, ember accent. -->
  <Color x:Key="AccentColor">#9A3412</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="#9A3412" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#7C2A0E" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#63220B" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#FDEBDD" />
  <SolidColorBrush x:Key="WindowBrush" Color="#F7F5F2" />
  <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="BorderBrush" Color="#CFC9C0" />
  <SolidColorBrush x:Key="TextBrush" Color="#26221E" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#6B645C" />
  <SolidColorBrush x:Key="HighlightBrush" Color="#EFEBE5" />
  <SolidColorBrush x:Key="PressedBrush" Color="#E3DDD4" />
  <SolidColorBrush x:Key="FocusBrush" Color="#1D4ED8" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#B91C1C" />
</ResourceDictionary>
